# Copy to .env and fill in your values
# cp .env.example .env

NODE_ENV=production
PORT=3001

# PostgreSQL — set this to enable persistence
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://wsm_user:CHANGE_ME@localhost:5432/widow_spider

# CORS — comma-separated list of allowed origins
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── TRON / USDT-TRC20 Payments ────────────────────────────────────────────────
# Leave blank to run in mock mode (no real transactions)

# Your house wallet private key (64-char hex, no 0x prefix)
# TRON_PRIVATE_KEY=your_private_key_here

# House wallet address (auto-derived from private key if not set)
# TRON_HOUSE_ADDRESS=TYourHouseAddressHere

# mainnet or testnet (default: testnet)
TRON_NETWORK=testnet

# TronGrid API key (free at trongrid.io — higher rate limits)
# TRONGRID_API_KEY=your_api_key_here
